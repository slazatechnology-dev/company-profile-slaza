rules_version = '2';

// Hanya pemilik PT yang boleh membaca dan menulis. Semua path lain ditolak.
// UID pemilik (akun Google yang dipakai login ke portal). Untuk mengganti pemilik, salin UID dari
// Firebase Console > Authentication > Users, ganti di bawah, lalu deploy:
//   npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'lxyI7N5lqNdb6WlCsZzAIb1ig1J2';
    }

    // Konten beranda (menu "Konten website" di portal): dibaca pengunjung website, hanya pemilik yang menulis.
    // site/home = teks semua bagian beranda, siteImages/{id} = gambar portofolio (data URL WebP).
    match /site/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /siteImages/{imageId} {
      allow read: if true;
      allow write: if isOwner() && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.matches('^data:image/.*')
        && request.resource.data.dataUrl.size() < 900000;
      allow delete: if isOwner();
    }

    // Satu dokumen per data. Daftar ini harus sama dengan COLLECTIONS di src/firebase.js
    match /{collection}/{docId} {
      allow read, write: if isOwner() && collection in [
        'clients', 'contracts', 'milestones', 'invoices',
        'taxRecords', 'maintenancePlans', 'expenses', 'settings'
      ];
    }
  }
}
